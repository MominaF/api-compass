# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Local Postgres+pgvector (docker compose) or Supabase.
# Supabase: Project Settings -> Database -> Connection string (URI). postgres:// URLs are
# rewritten to the asyncpg driver automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_compass

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Supabase project URL, used to fetch the public keys that verify access tokens.
SUPABASE_URL=
